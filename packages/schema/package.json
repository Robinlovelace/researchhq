{
  "name": "@researchhq/schema",
  "version": "0.1.0",
  "description": "TypeScript and Zod schemas, portfolio analytics, time-series projection, BibTeX export, and public-export sanitizer for ResearchHQ",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Robin Lovelace <Robinlovelace@users.noreply.github.com>",
  "homepage": "https://robinlovelace.net/researchhq/",
  "bugs": {
    "url": "https://github.com/Robinlovelace/researchhq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robinlovelace/researchhq.git",
    "directory": "packages/schema"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "research",
    "bibliometrics",
    "openalex",
    "open-science",
    "portfolio",
    "academic",
    "zod",
    "bibtex",
    "fwci",
    "journals"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  }
}
