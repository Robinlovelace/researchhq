{
  "name": "@researchhq/cli",
  "version": "0.1.0",
  "description": "CLI for syncing OpenAlex works and journal metrics, auditing impact, recommending venues, managing planned papers, and exporting ResearchHQ datasets",
  "license": "MIT",
  "type": "module",
  "bin": {
    "researchhq": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bundleDependencies": [
    "@researchhq/schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build && node ./scripts/stage-bundled-schema.mjs stage",
    "postpack": "node ./scripts/stage-bundled-schema.mjs clean"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Robin Lovelace <Robinlovelace@users.noreply.github.com>",
  "homepage": "https://robinlovelace.net/researchhq/",
  "bugs": {
    "url": "https://github.com/Robinlovelace/researchhq/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robinlovelace/researchhq.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "research",
    "bibliometrics",
    "openalex",
    "open-science",
    "portfolio",
    "cli",
    "academic",
    "journals",
    "zotero",
    "orcid"
  ],
  "dependencies": {
    "@researchhq/schema": "^0.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  }
}
